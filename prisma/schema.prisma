// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  createdAt    DateTime @default(now())

  plan               String    @default("free") // "free" | "pro" | "master"
  subscriptionStatus String? // null | "active" | "past_due" | "canceled" | "suspended"
  tossCustomerKey    String?   @unique
  tossBillingKey     String?   @unique
  currentPeriodEnd   DateTime?
  nextChargeAt       DateTime? // 다음 청구 시도 예정 시각(갱신 또는 재시도). null이면 청구 안 함
  canceledAt         DateTime?
  suspendedAt        DateTime?

  charges       SubscriptionCharge[]
  files         UploadedFile[]
  summaries     SummaryNote[]
  examConfigs   ExamConfig[]
  examPapers    ExamPaper[]
  attempts      ExamAttempt[]
  chatMessages  ChatMessage[]
  usageEvents   UsageEvent[]
  aiUsageEvents AiUsageEvent[]
  inquiries     Inquiry[]

  subjects              Subject[]
  calendarEvents        CalendarEvent[]
  studySessions         StudySession[]
  reviewItems           ReviewItem[]
  timerRoomsHosted      TimerRoom[]
  timerRoomParticipants TimerRoomParticipant[]

  studentProfile      StudentProfile?
  passwordResetTokens PasswordResetToken[]
  pdfTranslations     PdfTranslation[]
}

model SubscriptionCharge {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodKey     String // 연장 대상 currentPeriodEnd의 ISO 문자열
  attemptSeq    Int // 1 = 정기 갱신, 2 = 유일하게 허용된 재시도
  status        String // "pending" | "succeeded" | "failed"
  orderId       String   @unique
  amount        Int
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, periodKey, attemptSeq])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "note_generate" | "exam_generate" | "exam_grade" | "tutor_chat" | "pdf_translate" | "scholarship_match" | "activity_match"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum AiUsageFeature {
  NOTE_SUMMARY
  NOTE_EXPLANATION
  EXAM_BLUEPRINT
  EXAM_GENERATE
  EXAM_GRADE
  TUTOR_CHAT
  PDF_TRANSLATE
  SCHOLARSHIP_MATCH
  ACTIVITY_FIELD_MATCH
}

enum AiUsageStatus {
  SUCCESS
  FAILED
}

// Claude API 실제 호출 1건당 1행 — "제품 사용량"(UsageEvent, 무료 한도 소진 단위)과는
// 완전히 다른 개념이다. 예: PDF 번역은 UsageEvent 1건이지만 AiUsageEvent는 페이지 수만큼
// (최대 60건) 쌓인다. 절대 두 모델을 합치지 말 것 — 무료 한도 집계(getMonthlyUsageCount)가
// UsageEvent.count()에 의존하므로, 여기에 Claude 호출 단위 행을 섞으면 무료 사용량 한도가
// 조용히 잘못 계산된다.
model AiUsageEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   String // 호출 시점 User.plan 스냅샷("free" | "pro" | "master") — 이후 유저가 플랜을 바꿔도 과거 집계가 흔들리지 않게 시점 값을 그대로 남긴다

  feature     AiUsageFeature
  operationId String // 사용자 작업 1회에 딸린 Claude 호출 여러 건을 묶는 키. 예: 예상문제 생성 1회 = EXAM_BLUEPRINT + EXAM_GENERATE 2행이 같은 operationId를 공유. PDF 번역은 페이지 수만큼의 행이 문서 1건의 operationId를 공유.
  status      AiUsageStatus  @default(SUCCESS)

  model String // 호출에 실제 사용된 모델 ID(현재 claude-sonnet-5 고정). 추후 모델 다변화 대비.

  inputTokens              Int @default(0)
  outputTokens             Int @default(0)
  cacheCreationInputTokens Int @default(0)
  cacheReadInputTokens     Int @default(0)
  apiCallCount             Int @default(1) // 현재는 행당 항상 1(=호출 1건). 이후 한 행이 여러 실제 HTTP 시도를 대표해야 하는 경우(예: SDK 자동 재시도 합산)를 대비해 남겨둔 필드.

  estimatedInputCostUsd         Decimal @default(0) @db.Decimal(12, 8)
  estimatedOutputCostUsd        Decimal @default(0) @db.Decimal(12, 8)
  estimatedCacheCreationCostUsd Decimal @default(0) @db.Decimal(12, 8)
  estimatedCacheReadCostUsd     Decimal @default(0) @db.Decimal(12, 8)
  estimatedTotalCostUsd         Decimal @default(0) @db.Decimal(12, 8)

  metadata  Json? // 숫자/구조형 정보만 — 문서 원문·채팅 전문·학생 답안·장학금 목록 전체 등 실제 콘텐츠는 절대 넣지 않는다. 예: {"page":17,"totalPages":60}
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([operationId])
  @@index([feature, createdAt])
}

model Inquiry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String   @default("open") // "open" | "answered" | "closed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model UploadedFile {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId     String?
  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  originalName  String
  storedPath    String
  mimeType      String
  fileKind      String // "pdf" | "docx" | "image"
  sizeBytes     Int
  extractedText String?
  needsVision   Boolean  @default(false)
  purpose       String   @default("note") // "note" | "exam_reference" | "exam_past_exam"
  createdAt     DateTime @default(now())

  summaries    SummaryNote[]
  chatMessages ChatMessage[]

  @@index([userId])
  @@index([userId, purpose])
  @@index([subjectId])
}

model SummaryNote {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFileId String?
  sourceFile   UploadedFile? @relation(fields: [sourceFileId], references: [id])
  title        String
  type         String // "summary" | "explanation"
  contentJson  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([sourceFileId, type])
}

model ExamConfig {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  title             String
  mcqCount          Int      @default(0)
  shortCount        Int      @default(0)
  essayCount        Int      @default(0)
  timeLimitMinutes  Int
  difficulty        Int      @default(5) // 0(쉬움)~10(어려움), 기출문제 반영 강도와 같은 스케일
  professorNotes    String?
  sourceFileIdsJson String
  pastExamFileId    String?
  pastExamWeight    Int?
  createdAt         DateTime @default(now())

  examPaper ExamPaper?

  @@index([userId])
  @@index([subjectId])
}

model ChatMessage {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId    String
  file      UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime     @default(now())

  @@index([fileId])
  @@index([userId])
}

model ExamPaper {
  id          String     @id @default(cuid())
  configId    String     @unique
  config      ExamConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  totalPoints Int
  createdAt   DateTime   @default(now())

  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([userId])
}

model ExamQuestion {
  id            String    @id @default(cuid())
  examPaperId   String
  examPaper     ExamPaper @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  order         Int
  type          String // "mcq" | "short" | "essay"
  prompt        String
  choicesJson   String?
  correctAnswer String?
  modelAnswer   String?
  points        Int
  topicTag      String
  explanation   String?
  sourceLocation String? // 이 문제가 다루는 개념이 참고 자료의 어느 파일/페이지에 나오는지 (AI가 생성, 확신 없으면 null)

  answers     ExamAnswer[]
  reviewItems ReviewItem[]

  @@index([examPaperId])
}

model ExamAttempt {
  id            String    @id @default(cuid())
  examPaperId   String
  examPaper     ExamPaper @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  totalScore    Int?
  totalPossible Int?

  answers ExamAnswer[]

  @@index([examPaperId])
  @@index([userId])
}

model ExamAnswer {
  id                  String       @id @default(cuid())
  attemptId           String
  attempt             ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId          String
  question            ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswer       String
  isCorrect           Boolean?
  score               Int?
  maxScore            Int
  feedback            String?
  gradedBy            String // "auto" | "claude" | "manual"
  autoGradeConfidence Float?

  @@index([attemptId])
  @@index([questionId])
}

model Subject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#6b7280")
  isDefault Boolean  @default(false) // 마이그레이션 백필용 "미분류"만 true
  createdAt DateTime @default(now())

  examConfigs    ExamConfig[]
  calendarEvents CalendarEvent[]
  studySessions  StudySession[]
  reviewItems    ReviewItem[]
  timerRooms     TimerRoom[]
  files          UploadedFile[]

  @@unique([userId, name])
  @@index([userId])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  kind      String // "exam" | "assignment" | "other"
  title     String
  date      String // "YYYY-MM-DD"
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([subjectId, kind, date])
}

model StudySession {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String?
  subject         Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  roomId          String?
  room            TimerRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  mode            String // "simple" | "immersive"
  date            String // "YYYY-MM-DD" (캘린더 집계 기준 날짜)
  durationSeconds Int
  startedAt       DateTime
  endedAt         DateTime
  createdAt       DateTime   @default(now())

  @@index([userId, date])
  @@index([subjectId])
}

model TimerRoom {
  id           String    @id @default(cuid())
  code         String    @unique
  hostUserId   String
  host         User      @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  mode         String // "simple" | "immersive"
  status       String    @default("waiting") // "waiting" | "running" | "ended"
  studyMinutes Int       @default(50)
  breakMinutes Int       @default(10)
  startedAt    DateTime? // null이면 대기실(lobby), 호스트가 시작 누르면 세팅
  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  participants  TimerRoomParticipant[]
  studySessions StudySession[]

  @@index([hostUserId])
}

model TimerRoomParticipant {
  id              String    @id @default(cuid())
  roomId          String
  room            TimerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt        DateTime  @default(now())
  lastHeartbeatAt DateTime  @default(now())
  elapsedSeconds  Int       @default(0)
  completedSets   Int       @default(0)
  status          String    @default("active") // "active" | "left"

  @@unique([roomId, userId])
  @@index([roomId])
}

model ReviewItem {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questionId     String
  question       ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lastAttemptId  String?
  wrongCount     Int          @default(1)
  lastAnsweredAt DateTime     @default(now())
  resolvedAt     DateTime? // null = 큐에 활성 상태
  createdAt      DateTime     @default(now())

  @@unique([userId, questionId])
  @@index([userId, subjectId, resolvedAt])
  @@index([questionId])
}

model StudentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region        String? // 거주 지역 (시/도)
  major         String? // 전공/학과
  gradeLevel    Int? // 학년
  incomeBracket Int? // 소득분위 (0~10, 0 = 해당없음/모름)
  gpa           Float? // 직전 학기 평균 학점 (4.5 만점 기준) — 장학금 매칭에 사용
  interests     String? // 관심분야 (자유 텍스트, 쉼표 구분) — 대외활동/공모전 매칭에 사용
  updatedAt     DateTime @updatedAt

  // 대외활동/공모전 매칭용 AI 분류 캐시. PUT /api/profile 저장 시 major/interests가
  // 바뀐 경우에만 Claude(Haiku)로 1회 분류해서 채운다 — getActivitiesForUser는 이 캐시만
  // 읽고 페이지 조회마다 재분류하지 않는다. 사람이 짠 키워드 사전(FIELD_TAG_KEYWORDS,
  // 삭제됨)이 새 전공마다 오탐/누락을 반복해서 AI 분류로 대체함(src/lib/activity/classify.ts).
  activityFieldTags       String? // 쉼표 구분 카테고리 목록 (ActivityListing.fieldTags와 동일 포맷, 0개 이상 — 확신 없으면 빈 문자열)
  activityFieldTagsSource String? // 마지막 분류에 사용한 {major, interests} 스냅샷(JSON) — 재분류 필요 여부 판단용
}

model ScholarshipListing {
  id              String   @id @default(cuid())
  externalId      String   @unique // 원본 파일의 레코드 식별자 (운영기관명+상품명+모집시작일 조합, 중복 방지)
  provider        String // 운영기관명
  name            String // 상품명
  kind            String? // 운영기관구분/상품구분
  amountText      String? // 지원금액 (조건부 금액이 많아 원문 텍스트로 저장)
  eligibilityText String // 신청대상/소득기준/지역거주여부/학과구분 상세내용을 합친 원문
  applyPeriodText String? // 신청기간 원문
  applyUrl        String?
  applyStartDate  String? // "YYYY-MM-DD" 파싱 성공 시만 (정렬용)
  applyEndDate    String? // "YYYY-MM-DD" 파싱 성공 시만 (만료 판정용) — ActivityListing.deadlineDate와 동일 패턴
  fetchedAt       DateTime @default(now())

  @@index([fetchedAt])
  @@index([applyEndDate])
}

model ActivityListing {
  id               String   @id @default(cuid())
  title            String
  organizer        String?
  category         String // "contest" | "activity"
  fieldTags        String // 관련 분야 (쉼표 구분, 매칭용)
  targetInfo       String? // 지원 자격/대상 요약
  deadlineText     String? // 마감일 원문
  deadlineDate     String? // "YYYY-MM-DD" 파싱 성공 시만 (정렬/만료 판정용)
  sourceUrl        String // 주 출처 링크
  crossCheckedWith String? // 교차 확인된 추가 출처 URL
  fetchedAt        DateTime @default(now())

  @@unique([title, organizer])
  @@index([deadlineDate])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// DeepL Document Translation은 페이지 단위가 아니라 문서 전체를 한 번에 번역해서 번역된 PDF
// 파일 하나를 통째로 돌려준다(Claude vision+OCR 시절엔 페이지마다 별도 PNG를 만들어 저장했지만,
// 이제는 그럴 필요가 없다) — 그래서 페이지별 이미지를 담던 PdfTranslationPage 테이블은 없앴고,
// 번역된 PDF 전체 경로 하나만 저장한다. 뷰어가 보여줄 페이지 이미지는 원본과 마찬가지로 저장된
// PDF에서 그때그때 라스터화한다(원본은 이미 그렇게 하고 있었음 — /api/translate/[id]/page/[n]).
model PdfTranslation {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectName         String // 사용자가 직접 입력한 과목명(자유 텍스트) — 화면 표시/자료 정리용
  originalFileName    String
  originalStoredPath  String
  translatedStoredPath String? // DeepL이 반환한 번역된 PDF 전체 경로 — 완료 전에는 null
  pageCount           Int // 원본 PDF 전체 페이지 수
  translatedPageCount Int // 실제로 번역 요청한 페이지 수(무료/Pro 상한 반영 — DeepL에 보내기 전에 이 페이지 수만큼만 잘라서 업로드)
  status              String   @default("processing") // "processing" | "done" | "failed"
  errorMessage        String?
  createdAt           DateTime @default(now())

  @@index([userId])
}
